# Flux RPC Configuration
# Copy this file to .env and fill in your values

# RPC Connection
FLUX_RPC_HOST=127.0.0.1
FLUX_RPC_PORT=16124

# RPC Authentication (optional if using cookie file)
# FLUX_RPC_USERNAME=your_rpc_username
# FLUX_RPC_PASSWORD=your_rpc_password

# Custom cookie path (optional)
# FLUX_RPC_COOKIE_PATH=/path/to/.cookie

# Request timeout in seconds
FLUX_RPC_TIMEOUT=30

# Output Configuration
FLUX_OUTPUT_FORMAT=rich  # rich, json, or plain
FLUX_VERBOSE=false
FLUX_DEBUG=false
